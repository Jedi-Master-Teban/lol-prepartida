# Copia este archivo como .env y completa la clave.
# Clave de la API de Riot: https://developer.riotgames.com (la de desarrollo expira cada 24 h;
# la personal no expira y se solicita en el mismo portal).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Tu cuenta
RIOT_GAME_NAME=SithLordDropout
RIOT_TAG_LINE=LAN

# Enrutamiento: plataforma (servidor) y región (agrupación continental)
RIOT_PLATFORM=la1
RIOT_REGION=americas

# Idioma de los datos estáticos (nombres de campeones, ítems y runas)
DDRAGON_LOCALE=es_MX

# Carpeta de datos locales (base DuckDB y respuestas crudas)
PREPARTIDA_DATA_DIR=data
